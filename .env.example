# Copy this file to ".env" and fill in your values. The .env file is gitignored.
# Real environment variables (e.g. on Vercel) override anything set here.

# Microsoft OAuth — required for "Sign in with Microsoft" (Outlook / Hotmail / Live).
# Register an app at https://entra.microsoft.com (App registrations), allow personal
# Microsoft accounts, add a Web redirect URI <origin>/auth/microsoft/callback.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Any long random string; encrypts sign-in session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MS_TOKEN_SECRET=
# Optional: defaults to "common" (personal + work/school accounts).
# MS_TENANT=common

# Optional: Stripe donations.
# STRIPE_SECRET_KEY=

# --- Public-deployment guardrails (optional; sensible defaults if unset) ---
# Set your public HTTPS origin so OAuth redirects and Stripe URLs are correct in prod.
# PUBLIC_URL=https://your-app.onrender.com
# Largest inbox slice a single scan pulls (protects server + the user's browser). Default 100000.
# MAX_SCAN=30000
# Max simultaneous heavy operations (scan/sort): overall and per visitor.
# MAX_CONCURRENT=6
# MAX_CONCURRENT_PER_IP=2
# Per-IP request caps per 15-minute window.
# RL_API_MAX=200
# RL_SCAN_MAX=30
# RL_UNSUB_MAX=15
